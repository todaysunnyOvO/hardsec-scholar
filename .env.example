# Optional upstream Open Deep Research settings. HardSec Scholar itself uses the
# dedicated LLM_* and EMBEDDING_* fields below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# HardSec Scholar model configuration. "openai" means OpenAI-compatible API.
# Verified example: DeepSeek LLM + SiliconFlow BAAI/bge-m3 embeddings.
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Web search is disabled for corpus-only questions by default.
ALLOW_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# Local web application
NEXT_PUBLIC_API_URL=http://localhost:8000
